#!/usr/bin/env bash

set -euo pipefail

# Where we are
readonly BASE_DIR="$PWD"

# Build directory
readonly TMP_DIR="$BASE_DIR/tmp"

# Output directory
readonly BUILDS_DIR="$BASE_DIR/builds"

# Get config
readonly CONFIG_FILE="options"

# Build Arch (amd64 or arm64)
ARCH=""

# Repo channel
CHANNEL=""

# Release variant
RELEASE=""

# Needs for lb config script
export ARCH
export CHANNEL

die() {
    echo "E: $*" >&2
    exit 1
}

# List of available options
show_help() {
    cat << EOF
Usage: $0 [OPTIONS]

Options:
  --arch <arch>         Build result architecture (amd64, arm64)
  --release <variant>   Release variant (stable, beta, testing)
  --help                Show this message
EOF
    exit 0
}

validate_arch() {
    case "$1" in
        amd64|arm64) return 0 ;;
        *) return 1 ;;
    esac
}

validate_release() {
    case "$1" in
        stable|beta|testing) return 0 ;;
        *) return 1 ;;
    esac
}

set_channel() {
    case "$RELEASE" in
        stable) CHANNEL="stable" ;;
        beta)   CHANNEL="stable" ;;  # Beta uses stable repo channel
        testing) CHANNEL="dev" ;;
    esac
}

# Check required dependencies (on Debian or Ubuntu)
check_deps() {
    echo "-> Checking dependencies..."

    apt update -y || die "Failed to update package lists"
    apt install -y lsb-release || die "Failed to install lsb-release"

    local dist
    dist="$(lsb_release -i -s)"

    if [[ "$dist" == "Debian" ]]; then
        apt install -y binutils patch zstd live-build || die "Failed to install build dependencies"
        apt install -y ./debs/ubuntu-keyring*.deb || die "Failed to install ubuntu-keyring"
    else
        apt install -y binutils patch zstd debootstrap || die "Failed to install build dependencies"
        apt install -y ./debs/*.deb || die "Failed to install local packages"
    fi

    if [[ "$ARCH" == "arm64" ]]; then
        apt install -y qemu-user-static binfmt-support || die "Failed to install ARM64 dependencies"
        update-binfmts --enable
    fi
}

# Cleanup build environment
cleanup() {
    echo "-> Cleaning up build environment..."
    lb clean 2>/dev/null || true
    rm -rf "$TMP_DIR"
}
# live-build ISO building
build() {
    echo -e "\n#------------------#"
    echo "# START BUILD #"
    echo "#------------------#\n"

    # Enable Resolute build in debootstrap
    ln -sfn /usr/share/debootstrap/scripts/gutsy /usr/share/debootstrap/scripts/resolute

    # Prepare build directory
    mkdir -p "$TMP_DIR/$ARCH"
    cd "$TMP_DIR/$ARCH" || die "Failed to enter build directory"

    # Clean and copy configuration
    rm -rf config auto
    cp -vr "$BASE_DIR"/auto . || die "Failed to copy auto configs"
    cp -vr "$BASE_DIR"/config . || die "Failed to copy configs"
    cp -vf "$BASE_DIR/$CONFIG_FILE" options || die "Failed to copy options file"

    # Setup package lists
    ln -sf "package-lists.$PACKAGE_LISTS_SUFFIX" "config/package-lists"

    # Build
    lb config || die "lb config failed"
    lb build || die "lb build failed"
}

# Make the final ISO
make_iso() {
    echo -e "\n#---------------------------#"
    echo "# MOVE OUTPUT TO BUILDS DIR #"
    echo "#---------------------------#\n"

    local timestamp
    timestamp="$(date +%Y%m%d%H%M)"
    local output_dir="$BUILDS_DIR/$ARCH"
    mkdir -p "$output_dir"

    local fname
    case "$RELEASE" in
        testing)
            fname="ubuntusway-$VERSION-$CHANNEL-$timestamp-$OUTPUT_SUFFIX-$ARCH"
            ;;
        beta)
            fname="ubuntusway-$VERSION-beta-$OUTPUT_SUFFIX-$ARCH"
            ;;
        stable)
            fname="ubuntusway-$VERSION-$OUTPUT_SUFFIX-$ARCH"
            ;;
    esac

    local iso_source="$TMP_DIR/$ARCH/live-image-$ARCH.hybrid.iso"
    local iso_target="$output_dir/${fname}.iso"

    [[ -f "$iso_source" ]] || die "ISO file not found: $iso_source"

    mv "$iso_source" "$iso_target"
    md5sum "$iso_target" > "$output_dir/${fname}.md5.txt"
    sha256sum "$iso_target" > "$output_dir/${fname}.sha256.txt"

    echo "-> Build complete: $iso_target"
}

main() {
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --arch)
                [[ -n "${2:-}" ]] || die "--arch requires an argument"
                ARCH="$2"
                shift 2
                ;;
            --release)
                [[ -n "${2:-}" ]] || die "--release requires an argument"
                RELEASE="$2"
                shift 2
                ;;
            --help)
                show_help
                ;;
            *)
                die "Unknown option: $1"
                ;;
        esac
    done

    # Validate required arguments
    [[ -n "$ARCH" ]] || die "--arch is required"
    [[ -n "$RELEASE" ]] || die "--release is required"

    # Validate values
    validate_arch "$ARCH" || die "Invalid value for --arch: $ARCH (must be amd64 or arm64)"
    validate_release "$RELEASE" || die "Invalid value for --release: $RELEASE (must be stable, beta, or testing)"

    # Check permissions
    [[ "$(id -u)" == 0 ]] || die "This script requires root permissions"

    # Load config
    [[ -f "$BASE_DIR/$CONFIG_FILE" ]] || die "Config file not found: $CONFIG_FILE"
    # shellcheck source=/dev/null
    source "$BASE_DIR/$CONFIG_FILE"

    # Set channel based on release
    set_channel

    # Execute build pipeline
    rm -rf "$BUILDS_DIR"
    check_deps
    cleanup
    build
    make_iso
    cleanup

    echo -e "\n#------------------#"
    echo "# BUILD SUCCESSFUL #"
    echo "#------------------#"
}

# Run main function
main "$@"
