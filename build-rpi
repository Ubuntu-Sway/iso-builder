#!/bin/bash
set -euo pipefail

readonly ROOT_DIR="$PWD"
readonly BASE_DIR="$ROOT_DIR/artifacts/ubuntusway-rpi"
readonly CONFIG_FILE="options"

RELEASE=""
CHANNEL=""

die() {
    echo "E: $*" >&2
    exit 1
}

show_help() {
    cat << EOF
Usage: $0 [OPTIONS]

Options:
  --release <variant>   Release variant (stable, beta, testing)
  --help                Show this message
EOF
    exit 0
}

validate_release() {
    case "$1" in
        stable|beta|testing) return 0 ;;
        *) return 1 ;;
    esac
}

set_channel() {
    case "$RELEASE" in
        stable) CHANNEL="stable" ;;
        beta)   CHANNEL="stable" ;;
        testing) CHANNEL="dev" ;;
    esac
}

section_header() {
    echo -e "\n#----------------------#"
    echo "# $1 #"
    echo "#----------------------#\n"
}

# Helper to run commands inside the container
run_in_container() {
    systemd-nspawn -D "$BASE_DIR/rpi-rootfs" "$@"
}

# Helper for multi-line bash scripts
run_in_container_bash() {
    run_in_container bash -c "$1"
}

check_deps() {
    section_header "INSTALL DEPENDENCIES"

    apt-get update || die "Failed to update package lists"
    apt-get install -y --no-install-recommends \
        debian-keyring ca-certificates debootstrap git \
        qemu-user-static qemu-utils qemu-system-arm binfmt-support \
        parted kpartx rsync dosfstools xz-utils whois \
        systemd-container || die "Failed to install dependencies"

    update-binfmts --enable
}

pre_cleanup() {
    section_header "REMOVE OLD BUILDS"

    if [[ -d "$ROOT_DIR/artifacts" ]]; then
        rm -rf "$ROOT_DIR/artifacts"
    fi
}

bootstrap() {
    section_header "BOOTSTRAP BASE SYSTEM"

    mkdir -p "${BASE_DIR}"
    cd "${BASE_DIR}" || die "Failed to enter BASE_DIR"

    # Enable Resolute build in debootstrap
    ln -sfn /usr/share/debootstrap/scripts/gutsy /usr/share/debootstrap/scripts/resolute

    debootstrap \
        --arch arm64 \
        --components=main,restricted,universe,multiverse \
        --foreign \
        --include=cloud-guest-utils \
        "$CODENAME" rpi-rootfs http://ports.ubuntu.com/ubuntu-ports || die "Debootstrap failed"

    # Add QEMU emulator for running ARM executables
    cp -v /usr/bin/qemu-arm64-static rpi-rootfs/usr/bin/ || die "Failed to copy QEMU"

    # Run second stage of bootstrap
    run_in_container /debootstrap/debootstrap --second-stage || die "Second stage bootstrap failed"

    # Copy Raspberry Pi specific files
    cp -rv "${ROOT_DIR}"/rpi/rootfs/writable/* rpi-rootfs/ || die "Failed to copy RPi files"

    # Configure APT sources
    cat << EOF > rpi-rootfs/etc/apt/sources.list
deb http://ports.ubuntu.com/ubuntu-ports $CODENAME main restricted universe multiverse
deb http://ports.ubuntu.com/ubuntu-ports $CODENAME-updates main restricted universe multiverse
deb http://ports.ubuntu.com/ubuntu-ports $CODENAME-security main restricted universe multiverse
deb http://ports.ubuntu.com/ubuntu-ports $CODENAME-backports main restricted universe multiverse
EOF

    # Copy UbuntuSway PPAs/keys/apt config
    if [[ -d "${ROOT_DIR}"/config/archives ]]; then
        for f in "${ROOT_DIR}"/config/archives/*.list; do
            [[ -f "$f" ]] && cp -- "$f" "rpi-rootfs/etc/apt/sources.list.d/$(basename -- "$f")"
        done
        for f in "${ROOT_DIR}"/config/archives/*.key; do
            [[ -f "$f" ]] && cp -- "$f" "rpi-rootfs/etc/apt/trusted.gpg.d/$(basename -- "$f").asc"
        done
        for f in "${ROOT_DIR}"/config/archives/*.pref; do
            [[ -f "$f" ]] && cp -- "$f" "rpi-rootfs/etc/apt/preferences.d/$(basename -- "$f")"
        done
    fi

    # Configure repos with proper channel and codename
    if [[ -d rpi-rootfs/etc/apt/sources.list.d ]]; then
        sed -i "s/@CHANNEL/$CHANNEL/g" rpi-rootfs/etc/apt/sources.list.d/*.list* 2>/dev/null || true
        sed -i "s/@BASECODENAME/$CODENAME/g" rpi-rootfs/etc/apt/sources.list.d/*.list* 2>/dev/null || true
    fi

    if [[ -d rpi-rootfs/etc/apt/preferences.d ]]; then
        sed -i "s/@BASECODENAME/$CODENAME/g" rpi-rootfs/etc/apt/preferences.d/*.pref* 2>/dev/null || true
    fi

    # Configure hostname
    echo "ubuntusway" > rpi-rootfs/etc/hostname

    # Configure hosts
    cat << EOF > rpi-rootfs/etc/hosts
127.0.0.1       ubuntu-sway    localhost
::1             localhost ip6-localhost ip6-loopback
fe00::0         ip6-localnet
ff00::0         ip6-mcastprefix
ff02::1         ip6-allnodes
ff02::2         ip6-allrouters
EOF

    # Configure fstab
    cat << EOF > rpi-rootfs/etc/fstab
# <file system> <mount point>   <type>  <options>       <dump>  <pass>
LABEL=writable     /               ext4  discard,noatime,x-systemd.growfs     0  1
LABEL=system-boot  /boot/firmware  vfat  defaults                             0  1
EOF

    # Set environment variables for systemd-nspawn
    export LC_ALL=C.UTF-8
    export DEBIAN_FRONTEND=noninteractive
    export FK_MACHINE=none
}

install_packages() {
    section_header "INSTALL DESKTOP PACKAGES"

    # Install desktop packages - direct commands instead of temporary script
    run_in_container_bash "
        apt-get update
        apt-get -y upgrade
        apt-get -y install ubuntu-sway-minimal ubuntu-sway-desktop-raspi ubuntu-sway-standard
    " || die "Desktop package installation failed"

    section_header "INSTALL RASPBERRY PI SPECIFIC PACKAGES"

    # Install RPi specific packages
    run_in_container_bash "
        apt-get -y install linux-image-raspi linux-firmware-raspi \
            pi-bluetooth upower calamares-settings-ubuntu-sway-raspi
        apt-get -y install --no-install-recommends raspi-config
    " || die "RPi hardware packages installation failed"

    # Copy file overrides
    if [[ -d "${ROOT_DIR}"/config/includes.chroot ]]; then
        [[ -d "${ROOT_DIR}"/config/includes.chroot/etc/apt ]] && \
            cp -rv "${ROOT_DIR}"/config/includes.chroot/etc/apt/ rpi-rootfs/etc/
        [[ -d "${ROOT_DIR}"/config/includes.chroot/etc/netplan ]] && \
            cp -rv "${ROOT_DIR}"/config/includes.chroot/etc/netplan/ rpi-rootfs/etc/
        [[ -d "${ROOT_DIR}"/config/includes.chroot/usr ]] && \
            cp -rv "${ROOT_DIR}"/config/includes.chroot/usr rpi-rootfs/
    fi

    [[ -d "${ROOT_DIR}"/rpi/greetd ]] && \
        cp -rv "${ROOT_DIR}"/rpi/greetd/* rpi-rootfs/etc/greetd/ || true
}

post_install() {
    section_header "RUNNING HOOKS"

    # Run live hooks
    if [[ -d "${ROOT_DIR}"/config/hooks/live ]]; then
        mkdir -p rpi-rootfs/hooks
        cp -v "${ROOT_DIR}"/config/hooks/live/*.chroot rpi-rootfs/hooks/ 2>/dev/null || true

        for f in rpi-rootfs/hooks/*; do
            if [[ -f "$f" ]]; then
                local base
                base=$(basename "${f}")
                run_in_container "/hooks/${base}" || die "Hook ${base} failed"
            fi
        done

        rm -rf rpi-rootfs/hooks
    fi

    section_header "CREATING OEM USER"

    # Create OEM user - direct commands
    run_in_container_bash "
        DATE=\$(date +%m%H%M%S)
        PASSWD=\$(mkpasswd -m sha-512 oem \"\${DATE}\")
        addgroup --gid 29999 oem
        adduser --gecos 'OEM Configuration (temporary user)' \
            --add_extra_groups --disabled-password --gid 29999 --uid 29999 oem
        usermod -a -G adm,sudo -p \"\${PASSWD}\" oem
    " || die "OEM user creation failed"

    section_header "CREATING SWAPFILE"

    # Create swapfile service - write files directly
    mkdir -p rpi-rootfs/usr/lib/systemd/system/swap.target.wants

    cat << 'EOF' > rpi-rootfs/usr/lib/systemd/system/mkswap.service
[Unit]
Description=Create the default swapfile
DefaultDependencies=no
Requires=local-fs.target
After=local-fs.target
Before=swapfile.swap
ConditionPathExists=!/swapfile

[Service]
Type=oneshot
ExecStartPre=fallocate -l 1GiB /swapfile
ExecStartPre=chmod 600 /swapfile
ExecStart=mkswap /swapfile

[Install]
WantedBy=swap.target
EOF

    cat << 'EOF' > rpi-rootfs/usr/lib/systemd/system/swapfile.swap
[Unit]
Description=The default swapfile

[Swap]
What=/swapfile
EOF

    # Enable swap service - direct command
    run_in_container_bash "
        ln -s /usr/lib/systemd/system/mkswap.service /usr/lib/systemd/system/swap.target.wants/mkswap.service
        ln -s /usr/lib/systemd/system/swapfile.swap /usr/lib/systemd/system/swap.target.wants/swapfile.swap
        update-initramfs -u
    " || die "Swap setup failed"
}

post_cleanup() {
    section_header "CLEANING CHROOT"

    # Cleanup - direct commands instead of temporary script
    run_in_container_bash "
        apt-get -y autoremove
        apt-get -y autoclean
        apt-get -y clean

        rm -rf {*.bak,*.old}
        rm -rf wget-log
        rm -rf /boot/{*.bak,*.old}
        rm -rf /etc/ssh/ssh_host_*_key*
        rm -rf /etc/apt/*.save
        rm -rf /etc/apt/apt.conf.d/90cache
        rm -rf /etc/apt/sources.list.d/*.save
        rm -rf /root/.wget-hsts
        rm -rf /tmp/*
        rm -rf /var/log/apt/*
        rm -rf /var/log/alternatives.log
        rm -rf /var/log/bootstrap.log
        rm -rf /var/log/dpkg.log
        rm -rf /var/log/fontconfig.log
        rm -rf /var/cache/fontconfig/CACHEDIR.TAG
        rm -rf /var/crash/*
        rm -rf /var/lib/apt/lists/*
        rm -rf /var/lib/dpkg/*-old

        [ -L /var/lib/dbus/machine-id ] || rm -f /var/lib/dbus/machine-id
        echo '' > /etc/machine-id
    " || die "Cleanup failed"
}

create_image() {
    section_header "CREATING IMAGE FILE"

    local timestamp
    timestamp="$(date +%Y%m%d)"
    local imagename

    case "$RELEASE" in
        testing)
            imagename="ubuntusway-$VERSION-$CHANNEL-rpi-$timestamp"
            ;;
        beta)
            imagename="ubuntusway-$VERSION-beta-rpi"
            ;;
        stable)
            imagename="ubuntusway-$VERSION-$CHANNEL-rpi"
            ;;
    esac

    # Calculate image size
    local boot_size="256"
    local root_size
    root_size="$(du -cs --block-size=MB rpi-rootfs 2>/dev/null | tail -n1 | cut -d'M' -f1)"
    local pad_size="$(( (root_size / 10) / 2 ))"
    local raw_size="$((boot_size + root_size + pad_size))"

    # Create and partition disk image
    fallocate -l "${raw_size}"M "${BASE_DIR}/${imagename}.img" || die "Failed to create image file"

    cd "${BASE_DIR}" || die "Failed to enter BASE_DIR"

    parted "${imagename}.img" -s -- mklabel msdos
    parted "${imagename}.img" -s -a optimal -- mkpart primary fat32 1 "${boot_size}MB"
    parted "${imagename}.img" -s -a optimal -- mkpart primary ext4 "${boot_size}MB" 100%
    parted "${imagename}.img" -s set 1 boot on

    # Set up loop devices
    local loopdevice
    loopdevice=$(losetup -f --show "${BASE_DIR}/${imagename}.img") || die "Failed to setup loop device"
    local device
    device=$(kpartx -va "$loopdevice" | sed -E 's/.*(loop[0-9])p.*/\1/g' | head -1)
    device="/dev/mapper/${device}"
    local bootp="${device}p1"
    local rootp="${device}p2"

    # Create filesystems
    mkfs.vfat -n system-boot -S 512 -s 16 -v "$bootp" || die "Failed to create vfat filesystem"
    mkfs.ext4 -L writable -m 0 "$rootp" || die "Failed to create ext4 filesystem"

    # Mount partitions
    mkdir -p "${BASE_DIR}/bootp" "${BASE_DIR}/root"
    mount -t vfat "$bootp" "${BASE_DIR}/bootp" || die "Failed to mount boot partition"
    mount "$rootp" "${BASE_DIR}/root" || die "Failed to mount root partition"

    mkdir -p rpi-rootfs/boot/firmware
    mount -o bind "${BASE_DIR}/bootp/" rpi-rootfs/boot/firmware || die "Failed to bind mount firmware"

    # Copy RPi boot files
    if [[ -d "${ROOT_DIR}"/rpi/rootfs/system-boot ]]; then
        cp -rv "${ROOT_DIR}"/rpi/rootfs/system-boot/* rpi-rootfs/boot/firmware/ || die "Failed to copy boot files"
    fi

    # Detect kernel version
    local new_kernel
    new_kernel=$(find rpi-rootfs/boot/vmlinuz-* 2>/dev/null | tail -n1 | awk -F/ '{print $NF}' | cut -d'-' -f2-4)
    if [[ -z "${new_kernel}" ]]; then
        die "Could not detect the new kernel version"
    fi
    echo "Kernel: ${new_kernel}"

    # Copy kernels and firmware - direct commands instead of temporary script
    run_in_container_bash "
        cp -av /boot/vmlinuz-${new_kernel} /boot/firmware/vmlinuz
        cp -av /boot/initrd.img-${new_kernel} /boot/firmware/initrd.img
        cp -v /lib/firmware/${new_kernel}/device-tree/broadcom/* /boot/firmware/ 2>/dev/null || true
        cp -rv /lib/firmware/${new_kernel}/device-tree/overlays /boot/firmware/ 2>/dev/null || true
        cp -v /lib/linux-firmware-raspi/* /boot/firmware/ 2>/dev/null || true
    " || die "Kernel copy failed"

    # Unmount temporary mounts (systemd-nspawn handled its own mounts, we only unmount what we mounted)
    umount rpi-rootfs/boot/firmware 2>/dev/null || true

    # Sync rootfs to image
    echo "Rsyncing rootfs into image file"
    rsync -HPavz -q "${BASE_DIR}/rpi-rootfs/" "${BASE_DIR}/root/" || die "Rsync failed"

    # Cleanup mounts
    umount "$bootp" || die "Failed to unmount bootp"
    umount "$rootp" || die "Failed to unmount rootp"
    kpartx -dv "$loopdevice" || true
    losetup -d "$loopdevice" || true

    # Compress image
    echo "Compressing ${imagename}.img"
    xz -T0 -z "${BASE_DIR}/${imagename}.img" || die "Compression failed"

    cd "${BASE_DIR}" || die "Failed to enter BASE_DIR"

    # Generate checksums
    md5sum "${imagename}.img.xz" | tee "${imagename}.md5.txt"
    sha256sum "${imagename}.img.xz" | tee "${imagename}.sha256.txt"
}

main() {
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --release)
                [[ -n "${2:-}" ]] || die "--release requires an argument"
                RELEASE="$2"
                shift 2
                ;;
            --help)
                show_help
                ;;
            *)
                die "Unknown option: $1"
                ;;
        esac
    done

    # Validate required arguments
    [[ -n "$RELEASE" ]] || die "--release is required"
    validate_release "$RELEASE" || die "Invalid value for --release: $RELEASE (must be stable, beta, or testing)"

    # Check permissions
    [[ "$(id -u)" == 0 ]] || die "This script requires root permissions"

    # Load config
    [[ -f "$ROOT_DIR/$CONFIG_FILE" ]] || die "Config file not found: $CONFIG_FILE"
    # shellcheck source=/dev/null
    source "$ROOT_DIR/$CONFIG_FILE"

    # Set channel based on release
    set_channel

    # Execute build pipeline
    check_deps
    pre_cleanup
    bootstrap
    install_packages
    post_install
    post_cleanup
    create_image

    section_header "BUILD DONE"
}

# Run main function
main "$@"
